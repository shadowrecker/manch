# =========================================================================
# Manch — environment variables (one set for every module)
# Copy to .env.local and fill in. NEVER commit .env.local.
# The app BUILDS and BOOTS without these; each feature stays inert until its
# keys are supplied. NEXT_PUBLIC_* values are exposed to the browser — never
# put secrets in them.
# =========================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (DB + Auth + Storage) — one project for all modules ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_AUDIO=audio
SUPABASE_STORAGE_BUCKET_KITS=media-kits

# --- Anthropic (all generation) ---
ANTHROPIC_API_KEY=
# The code sends `temperature` and a forced `tool_choice` on every call
# (lib/ai/claude.ts). claude-sonnet-4-6 accepts both. Newer models (Sonnet 5,
# Opus 4.7+/5, Fable) reject `temperature` with a 400 — and Opus 5.5 / Fable 5.1
# also reject forced tool_choice — so changing this needs a code change first.
ANTHROPIC_MODEL=claude-sonnet-4-6
PROMPT_VERSION=dev

# --- OpenAI (Whisper for voice notes; embeddings for Deals match + Check corpus) ---
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
EMBEDDING_MODEL=text-embedding-3-small

# --- Vernacular NLP (Reels generation, Check verdict translation) ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# --- WhatsApp (360Dialog) — ONE number, routed to Post / Reels / Check ---
DIALOG360_API_KEY=
DIALOG360_BASE_URL=https://waba-v2.360dialog.io
DIALOG360_WEBHOOK_SECRET=
WHATSAPP_BOT_NUMBER=
WHATSAPP_TEMPLATE_DRAFT_DELIVERY=draft_delivery_v1
WHATSAPP_TEMPLATE_REELS_DELIVERY=reels_script_v1

# --- Razorpay — one account. Create these plans in the Razorpay dashboard. ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RZP_PLAN_PLUS_MONTHLY=
RZP_PLAN_PLUS_YEARLY=
RZP_PLAN_PRO_MONTHLY=
RZP_PLAN_PRO_YEARLY=
RZP_PLAN_TEAM_MONTHLY=
RZP_PLAN_TEAM_YEARLY=
RZP_PLAN_BRAND_MONTHLY=
RZP_PLAN_BRAND_YEARLY=
RZP_CONTENT_PACK_AMOUNT_PAISE=4900
# Deals commission via Razorpay Route
COMMISSION_BPS=500
RAZORPAY_ROUTE_ENABLED=false
RZP_PLATFORM_ACCOUNT_ID=

# --- LinkedIn (Post) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/post/linkedin/callback
PROXYCURL_API_KEY=

# --- Instagram / Meta Graph (Deals) ---
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/deals/instagram/callback
MEDIAKIT_RENDER_MODE=client
BRAND_DATA_PROVIDER_KEY=

# --- Fact-check corpus + media authenticity (Check) ---
PIB_RSS_URL=
BOOM_API_KEY=
ALTNEWS_FEED_URL=
GOOGLE_VISION_API_KEY=
GOOGLE_VIDEO_INTELLIGENCE_KEY=
TINEYE_API_KEY=
NEWSROOM_API_DEFAULT_QUOTA=10000
VERDICT_CACHE_TTL_HOURS=72

# --- Trend layer (Reels) ---
TREND_DATA_PROVIDER_KEY=

# --- Queue / cache (Upstash) ---
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron (Vercel Cron sends Authorization: Bearer $CRON_SECRET) ---
CRON_SECRET=
CORPUS_REFRESH_CRON_SECRET=

# --- Analytics / errors / email ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Manch <hello@manch.app>
